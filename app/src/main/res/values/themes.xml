<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme: neutral, no dynamic (Material You) tint. -->
    <style name="Theme.Search" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/appBackground</item>
        <item name="android:colorBackground">@color/appBackground</item>
        <item name="android:statusBarColor">@color/appBackground</item>
        <item name="android:navigationBarColor">@color/appBackground</item>
        <!-- Dark icons on the light status/nav bar so they stay visible. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Search.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/splashBg</item>
        <item name="android:statusBarColor">@color/splashBg</item>
        <item name="android:navigationBarColor">@color/splashBg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
